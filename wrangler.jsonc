// Your site's settings for Cloudflare. When the site updates itself (the "Update my site"
// workflow), your own parts are kept: its name, your storage bucket, your address and your
// settings. The rest comes from the latest version of the template.
{
  "name": "my-corner",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "my-corner-content",
      "preview_bucket_name": "my-corner-content"
    }
  ],
  "vars": {
    "TIMEZONE": "Europe/London"
  },
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/20 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
